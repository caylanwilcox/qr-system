# Copy to .env and fill in. Never commit .env (it is gitignored).
# Local scripts (scripts/, attendance-backend/) read this file.
# The Vercel functions in api/ read the same names from Vercel's environment variables.

# --- Firebase Admin service account (server-side only, full database access) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
# Paste the service account's private_key in double quotes, keeping the \n line breaks.
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_DATABASE_URL=

# Set to "false" after running: node scripts/sync-role-claims.js --apply
# Then the API trusts login-token roles only, never the database role field.
ALLOW_DB_ROLE_FALLBACK=

# --- SMTP for event notification emails (api/send-event-notifications.js) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Firebase web config for the React app (public by design; ends up in the browser) ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Older backend scripts (db.js, setAdminRole.js, setInitialSuperAdmin.js) still read
# PROJECT_ID, PRIVATE_KEY_ID, PRIVATE_KEY, CLIENT_EMAIL, CLIENT_ID instead.
